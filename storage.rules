rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Fotos e logos do mídia kit: qualquer visitante pode ver (o site é público),
    // mas só um usuário autenticado (o admin logado no painel) pode enviar/trocar.
    match /mediakit/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Bloqueia tudo o mais por padrão.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
